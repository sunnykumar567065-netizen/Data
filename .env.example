# Local development only. Never commit real secrets.
PORT=3000
NODE_ENV=development
ADMIN_USERNAME=admin
# Generate with: node -e "require('bcryptjs').hash('YOUR_LONG_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# Use a long random value (32+ bytes)
SESSION_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
